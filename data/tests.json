def create_questions(pairs, level, start_id):
    questions = []
    english_list = [e for _, e in pairs]
    tajik_list = [t for t, _ in pairs]
    qid = start_id

    for tajik, english in pairs:
        # Tajik -> English
        distractors = [x for x in english_list if x != english]
        options = [english] + random.sample(distractors, 3)
        random.shuffle(options)
        questions.append({
            "id": qid,
            "lessonId": qid,
            "level": level,
            "q": f"«{tajik}» ба англисӣ чӣ мешавад?",
            "options": options,
            "answer": english
        })
        qid += 1

        # English -> Tajik
        distractors = [x for x in tajik_list if x != tajik]
        options = [tajik] + random.sample(distractors, 3)
        random.shuffle(options)
        questions.append({
            "id": qid,
            "lessonId": qid,
            "level": level,
            "q": f"Калимаи «{english}» чи маъно дорад?",
            "options": options,
            "answer": tajik
        })
        qid += 1
    return questions

all_questions = []
current_id = 1

# Сохтани 400 савол
all_questions.extend(create_questions(beginner_pairs, "Ибтидоӣ", current_id))
current_id += 100
all_questions.extend(create_questions(intermediate_pairs, "Миёна", current_id))
current_id += 100
all_questions.extend(create_questions(advanced_pairs, "Пешрафта", current_id))
current_id += 100
all_questions.extend(create_questions(street_pairs, "Street English", current_id))

# Сохтани файли ниҳоӣ
output = {
    "total": 400,
